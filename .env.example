# DreamHost MySQL credentials
DATABASE_URL="mysql://DREAMHOST_DB_USER:DREAMHOST_DB_PASSWORD@mysql.your-domain.com:3306/DREAMHOST_DB_NAME"
DATABASE_HOST="mysql.your-domain.com"
DATABASE_PORT=3306
DATABASE_USER="DREAMHOST_DB_USER"
DATABASE_PASSWORD="DREAMHOST_DB_PASSWORD"
DATABASE_NAME="DREAMHOST_DB_NAME"

# Local API configuration
PORT=3000
ADMIN_ORIGIN="http://localhost:4200"
LANDING_ORIGIN="http://localhost:4321"

# Admin session
AUTH_SECRET="replace-with-a-long-random-secret"
