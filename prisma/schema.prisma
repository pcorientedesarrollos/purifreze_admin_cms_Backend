generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  videoUrl  String   @db.VarChar(500)
  name      String   @db.VarChar(255)
  label     String   @db.VarChar(255)
  featured  Boolean  @default(false)
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, id])
}

model Video {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  url       String   @db.VarChar(500)
  placement String   @default("gallery") @db.VarChar(30)
  vertical  Boolean  @default(true)
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, sortOrder, id])
}

model UseCard {
  id          Int      @id @default(autoincrement())
  type        String   @db.VarChar(20)
  title       String   @db.VarChar(255)
  description String?  @db.Text
  icon        String?  @db.VarChar(80)
  mediaUrl    String?  @db.VarChar(500)
  altText     String?  @db.VarChar(255)
  isVisible   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder, id])
}

model ComparisonRow {
  id             Int      @id @default(autoincrement())
  feature        String   @db.VarChar(255)
  category       String   @db.VarChar(80)
  purifrezeText  String   @db.VarChar(500)
  garrafonesText String   @db.VarChar(500)
  isVisible      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder, id])
}

model FaqItem {
  id        Int      @id @default(autoincrement())
  question  String   @db.Text
  answer    String   @db.Text
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, id])
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id            Int                    @id @default(autoincrement())
  title         String                 @db.VarChar(255)
  slug          String                 @unique @db.VarChar(255)
  excerpt       String                 @db.Text
  
  // Cover: imagen tradicional O ícono flat
  coverImageUrl String?                @db.VarChar(500)
  coverColor    String?                @db.VarChar(7)
  coverIcon     String?                @db.VarChar(20)
  coverSize     String?                @db.VarChar(10)
  
  // Organización
  category      String?                @db.VarChar(50)
  authorName    String?                @db.VarChar(100)
  authorInitials String?               @db.VarChar(5)
  
  // Stats
  views         Int                    @default(0)
  readMin       Int?
  
  // Contenido
  blocks        Json
  status        BlogPostStatus         @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  redirects     BlogPostSlugRedirect[]

  @@index([status, publishedAt])
  @@index([category])
}

model BlogPostSlugRedirect {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(255)
  postId    Int
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model SeoMetadata {
  id          Int      @id @default(autoincrement())
  entityType  String   @db.VarChar(50)
  entityId    String   @db.VarChar(100)
  
  // Meta tags básicos
  metaTitle   String?  @db.VarChar(60)
  metaDesc    String?  @db.VarChar(160)
  keywords    String?  @db.VarChar(200)
  
  // Open Graph
  ogTitle     String?  @db.VarChar(60)
  ogDesc      String?  @db.VarChar(160)
  ogImage     String?  @db.VarChar(500)
  
  // Twitter Cards
  twitterCard String?  @db.VarChar(20)
  
  // Técnico
  canonicalUrl String?  @db.VarChar(500)
  noIndex      Boolean  @default(false)
  noFollow     Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([entityType, entityId])
  @@index([entityType])
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(80)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
