generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  videoUrl  String   @db.VarChar(500)
  name      String   @db.VarChar(255)
  label     String   @db.VarChar(255)
  featured  Boolean  @default(false)
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, id])
}

model Video {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  url       String   @db.VarChar(500)
  vertical  Boolean  @default(true)
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, id])
}

model ComparisonRow {
  id             Int      @id @default(autoincrement())
  feature        String   @db.VarChar(255)
  category       String   @db.VarChar(80)
  purifrezeText  String   @db.VarChar(500)
  garrafonesText String   @db.VarChar(500)
  isVisible      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder, id])
}

model FaqItem {
  id        Int      @id @default(autoincrement())
  question  String   @db.Text
  answer    String   @db.Text
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, id])
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id            Int                    @id @default(autoincrement())
  title         String                 @db.VarChar(255)
  slug          String                 @unique @db.VarChar(255)
  excerpt       String                 @db.Text
  coverImageUrl String?                @db.VarChar(500)
  blocks        Json
  status        BlogPostStatus         @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  redirects     BlogPostSlugRedirect[]

  @@index([status, publishedAt])
}

model BlogPostSlugRedirect {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(255)
  postId    Int
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(80)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
